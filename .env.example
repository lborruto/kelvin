# Kelvin configuration for docker-compose.yml. Copy to .env next to it; never commit .env.
# Every value is optional. The normal setup: start Kelvin, open it, log in with the home's
# Cozytouch account, then connect Linky in Maison › Réglages.

# No password or token goes here: you log in through the browser and set Linky in Réglages.

# Time zone for schedules, energy days and the Linky sync (08:00 and 14:00).
TZ=Europe/Paris

# Recommended: the host names and addresses you use to reach Kelvin, comma-separated
# (e.g. kelvin.lan,192.168.1.10). Other Host headers are refused, which blocks DNS rebinding.
# localhost and 127.0.0.1 always pass. Empty: any host name is accepted.
KELVIN_ALLOWED_HOSTS=

# --- Set by the Docker image; for running outside Docker ---
# KELVIN_DATA=/data           # SQLite DB and account.json (0600); outside Docker: ./data
# KELVIN_WEB=/app/web         # the built web app served next to the API
# KELVIN_HOST=0.0.0.0         # `python -m kelvin` bind address; outside Docker: 127.0.0.1
# KELVIN_PORT=8080            # outside Docker: 8000

# --- Advanced (add them to `environment:` in docker-compose.yml to use them) ---
# KELVIN_FAKE=1               # the simulator: no Cozytouch or Linky calls; demo@kelvin.local / kelvin
# KELVIN_DEBUG=1              # serves the API docs at /docs
# MED_BASE_URL=https://www.myelectricaldata.fr
# Only behind a trusted reverse proxy: its address(es). Never '*' (refused).
# KELVIN_TRUSTED_PROXIES=172.18.0.2
# Unattended setup only (the login screen and Réglages are the normal path). Read only while
# $KELVIN_DATA/account.json does not exist. Compose interpolates `$`: write each `$` as `$$`.
# COZY_USER=
# COZY_PASS=
# MED_PRM=
# MED_TOKEN=
