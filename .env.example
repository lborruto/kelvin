# Kelvin configuration for docker-compose.yml. Copy to .env next to it; never commit .env.
# Every value is optional. The normal setup: start Kelvin, open it, log in with the home's
# Cozytouch account, then connect Linky in Réglages.

# No password or token goes here: you log in through the browser and set Linky in Réglages.

# --- Where Docker Compose publishes Kelvin ---
# The host address the port is published on. 127.0.0.1 (the default): this machine only.
# To reach Kelvin from other devices, set this host's LAN address (or 0.0.0.0) AND
# KELVIN_ALLOWED_HOSTS below: the first login claims the home, so an open, unclaimed Kelvin
# can be claimed by anyone who reaches it. Never publish Kelvin on the internet.
KELVIN_BIND=127.0.0.1
# The host port (http://localhost:8070). Compose only: inside the container Kelvin listens on
# 8080. (Outside Docker, KELVIN_PORT is the port `python -m kelvin` listens on; see below.)
KELVIN_PORT=8070
# The Docker volume that holds the data. Another copy of Kelvin on the same Docker host (a
# second checkout, a simulator run) uses its own volume, port and project name, or it would
# share this one's container and home:
#   KELVIN_VOLUME=kelvin_demo  KELVIN_PORT=8071  COMPOSE_PROJECT_NAME=kelvin-demo
KELVIN_VOLUME=kelvin_data
# COMPOSE_PROJECT_NAME=kelvin

# Time zone for schedules, energy days and the Linky sync (08:00 and 14:00).
TZ=Europe/Paris

# The host names and addresses you use to reach Kelvin, comma-separated
# (e.g. kelvin.lan,192.168.1.10). Other Host headers are refused, which blocks DNS rebinding.
# localhost and 127.0.0.1 always pass. Empty: any host name is accepted, and Kelvin logs a
# warning the first time it is reached by another name. Required once KELVIN_BIND is not
# 127.0.0.1.
KELVIN_ALLOWED_HOSTS=

# The simulator: no Cozytouch or Linky calls; log in with demo@kelvin.local / kelvin.
# `KELVIN_FAKE=1 docker compose up` works without editing this file. Give it its own
# KELVIN_VOLUME: Kelvin refuses to mix simulated and real data in one volume.
KELVIN_FAKE=0
# Simulator house: sauter, atlantic, thermor, experimental (empty: follows the login server).
KELVIN_FAKE_HOUSE=

# --- Set by the Docker image; for running outside Docker ---
# KELVIN_DATA=/data           # SQLite DB and account.json (0600); outside Docker: ./data
# KELVIN_WEB=/app/web         # the built web app served next to the API
# KELVIN_HOST=0.0.0.0         # `python -m kelvin` bind address; outside Docker: 127.0.0.1
#                             # (beyond loopback with no KELVIN_ALLOWED_HOSTS, a start warns)
# KELVIN_PORT=8080            # in the image; outside Docker: 8000 (above, it is Compose's host port)

# --- Advanced (add them to `environment:` in docker-compose.yml to use them) ---
# KELVIN_FAKE_SETUP_FAIL=     # simulator only: setup operations that always fail, e.g. delete_place
# KELVIN_DEBUG=1              # serves the API docs at /docs
# KELVIN_MCP=false            # removes the read-only MCP endpoint at /mcp (on by default; it
#                             # answers nothing until you create a token in Réglages › Compte › Accès MCP)
# MED_BASE_URL=https://www.myelectricaldata.fr
# Only behind a trusted reverse proxy: its address(es). Never '*' (refused).
# KELVIN_TRUSTED_PROXIES=172.18.0.2
# Unattended setup only (the login screen and Réglages are the normal path). Read only while
# $KELVIN_DATA/account.json does not exist. Compose interpolates `$`: write each `$` as `$$`.
# COZY_USER=
# COZY_PASS=
# Overkiz server of the home: sauter_cozytouch (default), atlantic_cozytouch, thermor_cozytouch,
# or an experimental one listed in the README. Used only when COZY_USER/COZY_PASS create the account.
# COZY_SERVER=sauter_cozytouch
# MED_PRM=
# MED_TOKEN=
